# Copy to .env.local and fill in (Supabase dashboard → Project Settings → API).
# .env.local is gitignored — never commit real keys.

# Project URL, e.g. https://diuxjplglmiicknboxbk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon public key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (SECRET — server only, used by /api/lead)
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications for new leads (Resend) ---
# Get an API key at https://resend.com (free). Without it, leads still save to DB.
RESEND_API_KEY=
# Where new-request emails are sent:
LEAD_NOTIFY_EMAIL=hello@journeyiceland.is
# From address — until journeyiceland.is is verified in Resend, leave the default:
LEAD_FROM_EMAIL=Journey Iceland <onboarding@resend.dev>
